{
  "name": "ANIFLIX Auto-Rename Bot",
  "description": "Telegram auto-renaming bot with optional metadata, thumbnails, and custom captions.",
  "keywords": ["Telegram", "Auto Rename", "Pyrogram", "MongoDB"],
  "repository": "https://github.com/example892010-cmd/ANIFLIX-AutoRename-Bot",
  "env": {
    "BOT_TOKEN": {
      "description": "Telegram bot token from BotFather",
      "required": true
    },
    "API_ID": {
      "description": "Numeric Telegram API ID from my.telegram.org",
      "required": true
    },
    "API_HASH": {
      "description": "Telegram API hash from my.telegram.org",
      "required": true
    },
    "DB_URL": {
      "description": "MongoDB URI beginning with mongodb:// or mongodb+srv://",
      "required": true
    },
    "DB_NAME": {
      "description": "MongoDB database name",
      "value": "autorenamebot",
      "required": false
    },
    "ADMIN": {
      "description": "Your Telegram numeric user ID; separate multiple IDs with spaces",
      "required": false
    },
    "LOG_CHANNEL": {
      "description": "Optional numeric log channel ID",
      "required": false
    },
    "SUPPORT_CHAT": {
      "description": "Optional numeric support chat ID",
      "required": false
    },
    "FORCE_SUB_CHANNELS": {
      "description": "Optional comma-separated public channel usernames without @",
      "required": false
    },
    "WEBHOOK": {
      "description": "Enable the HTTP health endpoint",
      "value": "true",
      "required": false
    }
  }
}
